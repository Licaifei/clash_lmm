import { common } from '@kit.AbilityKit';
import { preferences } from '@kit.ArkData';
import fileIo from '@ohos.file.fs';
import { SubscriptionStore } from './SubscriptionStore';
import { AppConfigStore } from './AppConfigStore';
import { GeneratedConfig } from '../models/MihomoModels';

const LOCAL_MIXED_PORT = 7890;
const LOCAL_CONTROLLER = '127.0.0.1:9090';
const CONFIG_DIR = '/mihomo';
const CONFIG_FILE = '/config.yaml';
const PREF_NAME = 'mihomo_config';
const KEY_GENERATED = 'generated_config';

const SECTION_KEYS: string[] = [
  'proxies:', 'proxy-groups:', 'rules:', 'proxy-providers:', 'rule-providers:'
];

export class MihomoConfigService {
  private context: common.UIAbilityContext;

  constructor(context: common.UIAbilityContext) {
    this.context = context;
  }

  generate(subStore: SubscriptionStore, configStore: AppConfigStore): GeneratedConfig {
    const active = subStore.getActive();
    if (active === null) {
      throw new Error('No active subscription selected');
    }
    const raw = subStore.loadContent(active.id);
    if (raw.length === 0) {
      throw new Error('Active subscription content is empty');
    }
    if (active.detectedFormat !== 'clash-yaml') {
      throw new Error('Active subscription format is not supported: ' + active.detectedFormat);
    }
    const settings = configStore.load();
    const secret = settings.controller.secret;
    const preserved = this.extractSections(raw);
    if (preserved['proxies:'] === undefined && preserved['proxy-providers:'] === undefined) {
      throw new Error('Subscription contains no proxies or proxy-providers');
    }
    const output = this.buildConfig(preserved, secret);
    const path = this.writeConfig(output);
    const timestamp = new Date().toISOString();
    const config: GeneratedConfig = {
      path: path,
      controllerUrl: 'http://' + LOCAL_CONTROLLER,
      controllerSecret: secret,
      mixedPort: LOCAL_MIXED_PORT,
      timestamp: timestamp
    };
    this.persistConfig(config);
    return config;
  }

  loadGeneratedConfig(): GeneratedConfig | null {
    try {
      const store = preferences.getPreferencesSync(this.context, { name: PREF_NAME });
      const raw = store.getSync(KEY_GENERATED, '') as string;
      if (raw.length === 0) {
        return null;
      }
      const config = JSON.parse(raw) as GeneratedConfig;
      if (typeof config.path !== 'string' || config.path.length === 0) {
        return null;
      }
      if (typeof config.controllerUrl !== 'string' || typeof config.controllerSecret !== 'string' ||
        typeof config.timestamp !== 'string' || typeof config.mixedPort !== 'number') {
        return null;
      }
      return config;
    } catch (_err) {
      return null;
    }
  }

  private persistConfig(config: GeneratedConfig): void {
    try {
      const store = preferences.getPreferencesSync(this.context, { name: PREF_NAME });
      store.putSync(KEY_GENERATED, JSON.stringify(config));
      store.flush();
    } catch (_err) {
      throw new Error('Failed to persist generated config metadata');
    }
  }

  private extractSections(raw: string): Record<string, string> {
    const lines = raw.split('\n');
    const sections: Record<string, string> = {};
    let currentKey = '';
    let currentLines: string[] = [];
    for (let i = 0; i < lines.length; i++) {
      const line = lines[i];
      if (line.length === 0 || (line.length > 0 && line[0] === ' ')) {
        if (currentKey.length > 0) {
          currentLines.push(line);
        }
      } else {
        if (currentKey.length > 0) {
          sections[currentKey] = currentLines.join('\n');
        }
        currentKey = '';
        currentLines = [];
        for (let j = 0; j < SECTION_KEYS.length; j++) {
          if (line.startsWith(SECTION_KEYS[j])) {
            currentKey = SECTION_KEYS[j];
            currentLines.push(line);
            break;
          }
        }
      }
    }
    if (currentKey.length > 0) {
      sections[currentKey] = currentLines.join('\n');
    }
    return sections;
  }

  private buildConfig(sections: Record<string, string>, secret: string): string {
    const lines: string[] = [];
    lines.push('# Generated by Mihomo Verge');
    lines.push('');
    lines.push('mixed-port: ' + LOCAL_MIXED_PORT);
    lines.push('allow-lan: false');
    lines.push('mode: rule');
    lines.push('external-controller: ' + LOCAL_CONTROLLER);
    if (secret.length > 0) {
      lines.push('secret: ' + this.quoteYaml(secret));
    }
    lines.push('');
    lines.push('dns:');
    lines.push('  enable: true');
    lines.push('  listen: 0.0.0.0:5353');
    lines.push('  enhanced-mode: redir-host');
    const keyOrder: string[] = [
      'proxies:', 'proxy-providers:', 'proxy-groups:', 'rules:', 'rule-providers:'
    ];
    for (let i = 0; i < keyOrder.length; i++) {
      const key = keyOrder[i];
      const content = sections[key];
      if (content !== undefined && content.length > 0) {
        lines.push('');
        lines.push(content);
      }
    }
    return lines.join('\n') + '\n';
  }

  private quoteYaml(value: string): string {
    if (value.length === 0) {
      return value;
    }
    let needsQuote = false;
    for (let i = 0; i < value.length; i++) {
      const ch = value[i];
      if (ch === ' ' || ch === '#' || ch === ':' || ch === '"' || ch === '\'' ||
        ch === '{' || ch === '}' || ch === '[' || ch === ']' || ch === ',' ||
        ch === '&' || ch === '*' || ch === '?' || ch === '|' || ch === '-' ||
        ch === '<' || ch === '>' || ch === '=' || ch === '!' || ch === '%' ||
        ch === '@' || ch === '\\') {
        needsQuote = true;
        break;
      }
    }
    if (!needsQuote) {
      return value;
    }
    let escaped = '';
    for (let i = 0; i < value.length; i++) {
      const ch = value[i];
      if (ch === '"') {
        escaped = escaped + '\\"';
      } else if (ch === '\\') {
        escaped = escaped + '\\\\';
      } else {
        escaped = escaped + ch;
      }
    }
    return '"' + escaped + '"';
  }

  private writeConfig(content: string): string {
    const dir = this.context.filesDir + CONFIG_DIR;
    try {
      fileIo.mkdirSync(dir, true);
    } catch (_err) {
      throw new Error('Failed to create config directory');
    }
    const path = dir + CONFIG_FILE;
    let fd = -1;
    try {
      const f = fileIo.openSync(path,
        fileIo.OpenMode.CREATE | fileIo.OpenMode.TRUNC | fileIo.OpenMode.WRITE_ONLY);
      fd = f.fd;
      fileIo.writeSync(fd, content);
    } catch (_err) {
      throw new Error('Failed to write config file');
    } finally {
      if (fd >= 0) {
        try {
          fileIo.closeSync(fd);
        } catch (_err) {
          // close failed, ignore
        }
      }
    }
    return path;
  }

  getConfigPath(): string {
    return this.context.filesDir + CONFIG_DIR + CONFIG_FILE;
  }
}
